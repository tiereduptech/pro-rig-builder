# write-catalog.cjs / split-parts-by-cat.cjs transient state (see write-catalog.cjs header).
# These only exist mid-write; if one survives a run, a write was interrupted.
src/data/.parts.tmp.js
src/data/.parts.staging/
src/data/.parts.old/

# Epik static-hosting artifacts generated by build-epik.cjs. Deliberately NOT
# committed: the deploy workflow regenerates them before every SFTP upload, and
# they are Epik-only files that would otherwise clutter the Railway-served dist/.
# Sources live in deploy/ (.htaccess, resolver.php) and are generated from
# server.cjs / product-redirects.json / index.html.
dist/.htaccess
dist/resolver.php
dist/resolver-config.php
dist/redirects.php
dist/gone.html
dist/.htpasswd
dist/_env.php
# Pull-deploy artifacts, produced by publish-epik.yml into the release branch —
# never committed to main. _ops/ carries the healthcheck harness into the release.
dist/RELEASE.json
dist/MANIFEST.sha256
dist/_ops/

# Cloudflare Pages artifacts generated by build-pages.cjs. Same reasoning as the
# Epik block above: regenerated before every deploy, and Pages-only.
dist/_headers
dist/_redirects
dist/404.html
# Trailing-slash siblings — <route>.html written next to <route>/index.html so
# the unslashed canonical URL serves at 200 instead of 308-ing (build-pages.cjs
# §4c). Every HTML file committed under dist/ is an index.html — all 5,519 of
# them — so ignoring *.html and re-including index.html names exactly the
# generated set, without having to list routes that change with the catalog.
dist/**/*.html
!dist/**/index.html

# The Worker-side generated module (PRODUCT_RE, the 301 map, the two shells).
# Rebuilt on every deploy from server.cjs / product-redirects.json / dist. A
# committed copy could go stale against them, which is the drift build-pages.cjs
# exists to prevent — so it is never committed.
#
# ROOT-ANCHORED. Unanchored, `functions-lib/` matches a directory of that name at
# ANY depth, and it silently swallowed admin/functions-lib/ — the admin
# dashboard's Access JWT verification, dispatch allowlist and GitHub client — on
# its first `git add`. Those are hand-written source, not generated, and the
# failure was invisible: `git add admin` simply reported fewer files. Only this
# directory is generated; keep the leading slash.
/functions-lib/

# The admin dashboard's derived constants (deploy/DESIGN-admin-dashboard.md §9.1).
# Same reasoning as functions-lib/: regenerated on every admin deploy by
# scripts/derive-constants.cjs, and a committed copy is exactly the stale number
# the derivation exists to prevent. Generate it locally before `wrangler pages dev`.
admin/public/constants.generated.json

# wrangler's local state / cache (wrangler pages dev).
.wrangler/
