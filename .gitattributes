# Server-side config for the Epik/Apache host must stay LF. CRLF in a .htaccess
# is a known Apache hazard (directives/paths can break); the PHP resolver and the
# Node deploy script also run on Linux. Force LF regardless of any core.autocrlf.
deploy/** text eol=lf
# Same reason: scripts/*.sh are curl'd from this repo and executed ON the box.
# A CRLF shebang there is a "bad interpreter" failure, so do not leave their
# line endings to whatever core.autocrlf the committing machine happens to have.
scripts/**.sh text eol=lf
# test/*.sh source deploy/*.sh directly, so a CRLF here would make the sourced
# file's LF-vs-CRLF mismatch the thing under test rather than the logic.
test/**.sh text eol=lf
